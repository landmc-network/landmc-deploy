# Copy to .env and fill in. .env is git-ignored: none of this belongs in the repository.

# Shared by every plugin that talks to Redis.
REDIS_PASSWORD=

# The database behind the friends list and the lobby profiles.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=landmc
MARIADB_USER=landmc
MARIADB_PASSWORD=

# Velocity's modern player-info forwarding. Must match forwarding.secret in
# servers/proxy/ and the value each backend is configured with, or players are
# rejected with "Unable to verify player details".
FORWARDING_SECRET=

# The port players connect to.
# Accepting the Minecraft EULA (https://aka.ms/MinecraftEULA) is your decision;
# setting this to true is how you record it.
ACCEPT_EULA=false

PROXY_PORT=25565

# The user the server containers write as; must own servers/. `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

PROXY_MEMORY=1G
LOBBY_MEMORY=2G
