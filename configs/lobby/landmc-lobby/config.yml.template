# See the note in configs/proxy: deployment-owned settings only, and ${...} resolved by the
# plugin from the environment rather than expanded into this file.

lobby:
  server-id: lobby-1

database:
  type: ${LANDMC_DB_TYPE}
  host: ${LANDMC_DB_HOST}
  port: ${LANDMC_DB_PORT}
  database: ${LANDMC_DB_NAME}
  username: ${LANDMC_DB_USER}
  password: ${LANDMC_DB_PASSWORD}
  use-ssl: false
  pool-size: 8

messaging:
  enabled: true
  redis:
    host: ${LANDMC_REDIS_HOST}
    port: ${LANDMC_REDIS_PORT}
    username: ''
    password: ${LANDMC_REDIS_PASSWORD}
    database: 0
    ssl: false
    channel-prefix: landmc

# The world settings the plugin applies at startup. Which world is generated empty is decided in
# servers/lobby/bukkit.yml; this only says which worlds get the spawn point and the game rules.
world:
  worlds:
    - lobby
  set-spawn-point: true
  spawn-x: 0.0
  spawn-y: 100.0
  spawn-z: 0.0
  gamerules:
    randomTickSpeed: '0'
