# Only what the deployment decides. Everything else the plugin fills in with its own defaults
# on first start, and is edited in servers/proxy/plugins/landmc-proxy/config.yml from then on.
#
# The ${...} names are resolved by the plugin at startup, from the container's environment -
# compose passes them in from .env. They are deliberately NOT expanded here: the credentials
# then exist in .env and nowhere under plugins/, and moving the database is one edit for the
# whole network rather than one per plugin.

proxy:
  server-id: proxy-1

routing:
  fallback-server: lobby

friends:
  enabled: true

database:
  type: ${LANDMC_DB_TYPE}
  host: ${LANDMC_DB_HOST}
  port: ${LANDMC_DB_PORT}
  database: ${LANDMC_DB_NAME}
  username: ${LANDMC_DB_USER}
  password: ${LANDMC_DB_PASSWORD}
  use-ssl: false
  # The proxy only touches the database for the friends list, which is not a hot path.
  pool-size: 4

messaging:
  enabled: true
  redis:
    host: ${LANDMC_REDIS_HOST}
    port: ${LANDMC_REDIS_PORT}
    username: ''
    password: ${LANDMC_REDIS_PASSWORD}
    database: 0
    ssl: false
    channel-prefix: landmc

# The server menu. Only what is listed here appears, in this order - listing whatever is in
# velocity.toml would put the limbo in it, which is a world with nothing in it that a player
# would click once and then have to be rescued from.
menus:
  servers-enabled: true
  servers:
    lobby: Lobby
    skyblock: SkyBlock
  # A socket, not a Minecraft ping: the backends run with enable-status=false.
  reachability-timeout-millis: 1500

# /live - a streamer announces their stream to the whole network.
#
# Off until the credentials exist: without them nothing can be verified, and an announcement
# that is not verified is an advertising slot. Both are OAuth applications you register on the
# platform - Twitch at dev.twitch.tv/console/apps, Kick in its developer settings.
#
# They can be written here or given as ${VARIABLE}, resolved from the container's environment
# exactly like the database credentials - which is what keeps them out of a file somebody
# pastes into a ticket.
live:
  enabled: false
  cooldown-minutes: 30
  twitch:
    client-id: ''
    client-secret: ''
  kick:
    client-id: ''
    client-secret: ''
