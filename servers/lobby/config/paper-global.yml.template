# Rendered by scripts/setup.sh; the secret comes from .env and never enters the repository.
_version: 33

proxies:
  velocity:
    enabled: true
    online-mode: true
    secret: '${FORWARDING_SECRET}'
  bungee-cord:
    online-mode: false

# Compression is the proxy's job once; doing it again per backend hop is wasted CPU on both
# ends of a link that never leaves the docker network.
packet-limiter:
  all-packets:
    action: KICK
    interval: 7.0
    max-packet-rate: 500.0

logging:
  deobfuscate-stacktraces: true

console:
  enable-brigadier-highlighting: true
  enable-brigadier-completions: true

chunk-system:
  gen-parallelism: default
  io-threads: -1
  worker-threads: -1
